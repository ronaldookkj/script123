local playerToken = 0
local function removePlayerVisuals()
    for obj in pairs(S.playerObjects) do safeDestroy(obj) S.playerObjects[obj] = nil end
end
local function playerRefresh(p)
    if S.destroyed or not flags.PlayerESP or p == LP then return end
    local char = p.Character
    local otherRoot = root(char)
    if not char or not otherRoot then return end
    local high = char:FindFirstChild("__DWLevePlayerESP")
    if not high then
        high = Instance.new("Highlight")
        high.Name = "__DWLevePlayerESP"
        high.Adornee = char
        high.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
        high.FillTransparency = .78
        high.OutlineTransparency = 0
        high.FillColor = colors.PlayerESP
        high.OutlineColor = colors.PlayerESP
        high.Parent = char
        S.playerObjects[high] = true
    end
    local bill = otherRoot:FindFirstChild("__DWLevePlayerInfo")
    if flags.PlayerInfo then
        if not bill then
            bill = Instance.new("BillboardGui")
            bill.Name = "__DWLevePlayerInfo"
            bill.Adornee = otherRoot
            bill.AlwaysOnTop = true
            bill.Size = UDim2.fromOffset(155, 44)
            bill.StudsOffsetWorldSpace = Vector3.new(0, 3.2, 0)
            bill.Parent = otherRoot
            S.playerObjects[bill] = true
            local frame = Instance.new("Frame")
            frame.Name = "Holder"
            frame.Size = UDim2.fromScale(1, 1)
            frame.BackgroundTransparency = .35
            frame.BackgroundColor3 = Color3.fromRGB(12, 12, 14)
            frame.Parent = bill
            Instance.new("UICorner", frame).CornerRadius = UDim.new(0, 6)
            local label = Instance.new("TextLabel")
            label.Name = "Info"
            label.Size = UDim2.fromScale(1, 1)
            label.BackgroundTransparency = 1
            label.TextColor3 = colors.PlayerESP
            label.TextSize = 11
            label.TextWrapped = true
            label.Font = Enum.Font.GothamBold
            label.Parent = frame
        end
        local info = bill:FindFirstChild("Holder")
        info = info and info:FindFirstChild("Info")
        local myRoot = root(LP.Character)
        local hum = char:FindFirstChildOfClass("Humanoid")
        if info and myRoot then
            info.Text = string.format("%s\n%dm | HP %d", p.DisplayName,
                math.floor((otherRoot.Position - myRoot.Position).Magnitude + .5),
                hum and math.floor(hum.Health + .5) or 0)
        end
    elseif bill then
        S.playerObjects[bill] = nil
        safeDestroy(bill)
    end
end
local function resetPlayers()
    playerToken += 1
    disconnect(S.playerConns)
    removePlayerVisuals()
    if not flags.PlayerESP then return end
    local token = playerToken
    local function bindPlayer(p)
        if p == LP then return end
        conn(p.CharacterAdded, function()
            task.delay(.35, function()
                if not S.destroyed and token == playerToken then playerRefresh(p) end
            end)
        end, S.playerConns)
        playerRefresh(p)
    end
    for _, p in ipairs(Players:GetPlayers()) do bindPlayer(p) end
    conn(Players.PlayerAdded, bindPlayer, S.playerConns)
    task.spawn(function()
        while not S.destroyed and flags.PlayerESP and token == playerToken do
            for _, p in ipairs(Players:GetPlayers()) do playerRefresh(p) end
            task.wait(1)
        end
    end)
end

-- ============================================================
-- AUTO SKILL CHECK: sem sobrescrever callback na inicialização
-- ============================================================
local skillToken = 0
local function setSkill(value)
    skillToken += 1
    local token = skillToken
    if not value then
        if S.skillRemote and S.skillCallback then
            pcall(function()
                S.skillRemote.OnClientInvoke = S.skillOriginal
            end)
        end
        S.skillRemote, S.skillOriginal, S.skillCallback = nil, nil, nil
        return
    end
    task.spawn(function()
        local events = RS:FindFirstChild("Events") or RS:WaitForChild("Events", 10)
        if not events or token ~= skillToken or S.destroyed then return end
        local remote = events:FindFirstChild("SkillcheckUpdate")
            or events:WaitForChild("SkillcheckUpdate", 10)
        if not remote or not remote:IsA("RemoteFunction")
            or token ~= skillToken or S.destroyed then return end
        local original = nil
        if type(getcallbackvalue) == "function" then
            local ok, result = pcall(getcallbackvalue, remote, "OnClientInvoke")
            if ok and type(result) == "function" then original = result end
        end
        if not original then
            pcall(function() original = remote.OnClientInvoke end)
        end
        local cb = function() return "supercomplete" end
        local ok, err = pcall(function() remote.OnClientInvoke = cb end)
        if ok then
            S.skillRemote, S.skillOriginal, S.skillCallback = remote, original, cb
        else
            warn("[DW] AutoSkill indisponível: " .. tostring(err))
        end
    end)
end

-- ============================================================
-- STAMINA + BUFF: rotina do patch que o usuário confirmou
-- O observador de velocidade só funciona no loop da stamina ON.
-- ============================================================
local Stamina = { enabled = false, destroyed = false }
local character, humanoid, sprinting, normalWalkSpeed
local sprintHeld, controllerHeld, mobileHeld = false, false, false
local sprintEvent, mobileConn, mobileButton
local originalSprintConnections, originalMobileConnections = {}, {}
local savedInterface = {}
local speedBonus, lastAppliedSpeed, runSpeedBase, trackedCharacter = 0, nil, nil, nil

local function refreshCharacter(char)
    character = char
    humanoid = char and (char:FindFirstChildOfClass("Humanoid") or char:WaitForChild("Humanoid", 10))
    local stats = char and (char:FindFirstChild("Stats") or char:WaitForChild("Stats", 10))
    sprinting = stats and stats:FindFirstChild("Sprinting")
    normalWalkSpeed = humanoid and humanoid.WalkSpeed
    sprintHeld, controllerHeld, mobileHeld = false, false, false
    speedBonus, lastAppliedSpeed, runSpeedBase, trackedCharacter = 0, nil, nil, char
end
local function findSprintEvent()
    local events = RS:FindFirstChild("Events")
    local evt = events and events:FindFirstChild("SprintEvent")
    sprintEvent = evt and evt:IsA("RemoteEvent") and evt or nil
end
local function setCapturedEnabled(bucket, yes)
    for _, c in ipairs(bucket) do
        pcall(function()
            if yes then c:Enable() else c:Disable() end
        end)
    end
end
local function captureConnections(signal, bucket)
    if type(getconnections) ~= "function" or not signal then return end
    local ok, list = pcall(getconnections, signal)
    if not ok or type(list) ~= "table" then return end
    for _, c in ipairs(list) do
        if c ~= mobileConn then
            local exists = false
            for _, saved in ipairs(bucket) do
                if saved == c then exists = true break end
            end
            if not exists then table.insert(bucket, c) end
        end
    end
end
local function sprintWanted()
    return Stamina.enabled and (sprintHeld or controllerHeld or mobileHeld)
end
local function getRunSpeed()
    if not humanoid or not humanoid.Parent or not normalWalkSpeed then return nil end
    if trackedCharacter ~= character then
        trackedCharacter = character
        speedBonus, lastAppliedSpeed, runSpeedBase = 0, nil, nil
    end
    if not runSpeedBase then
        local initialSpeed = LP:GetAttribute("KM_MAX_PLAYER_SPEED")
        runSpeedBase = (type(initialSpeed) == "number" and initialSpeed > 0)
            and initialSpeed or (normalWalkSpeed + 10)
    end
    local observed = humanoid.WalkSpeed
    if lastAppliedSpeed == nil or math.abs(observed - lastAppliedSpeed) > .05 then
        local fromWalk = observed - normalWalkSpeed
        local fromRun = observed - runSpeedBase
        local possible = nil
        if fromWalk >= 0 then possible = fromWalk end
        if fromRun >= 0 and (possible == nil or
            math.abs(fromRun - speedBonus) < math.abs(possible - speedBonus)) then
            possible = fromRun
        end
        if possible ~= nil then speedBonus = math.clamp(possible, 0, 15) end
    end
    return runSpeedBase + speedBonus
end
local function applySpeedState()
    if not humanoid or not humanoid.Parent or not normalWalkSpeed then return end
    local desired
    if sprintWanted() then desired = getRunSpeed()
    else desired = normalWalkSpeed + speedBonus end
    if type(desired) ~= "number" or desired <= 0 then return end
    lastAppliedSpeed = desired
    if math.abs(humanoid.WalkSpeed - desired) > .05 then
        humanoid.WalkSpeed = desired
    end
end
local function sendSprint(value)
    if not sprintEvent then findSprintEvent() end
    if sprintEvent then pcall(function() sprintEvent:FireServer(value) end) end
end
local function updateMobileInterface(on)
    local screen = PG:FindFirstChild("ScreenGui")
    local button = screen and screen:FindFirstChild("MobileRun")
    if not button then return end
    if not savedInterface[button] then
        savedInterface[button] = { Image = button.Image }
    end
    local txt = button:FindFirstChild("TextLabel")
    if txt and not savedInterface[txt] then savedInterface[txt] = { Text = txt.Text } end
    if txt then txt.Text = on and "SPRINT: ON" or "SPRINT: OFF" end
    pcall(function()
        button.Image = on and "rbxassetid://11866539249" or "rbxassetid://11866517702"
    end)
    local icon = screen:FindFirstChild("SprintIcon")
    if icon and on then
        if not savedInterface[icon] then savedInterface[icon] = { Visible = icon.Visible } end
        icon.Visible = false
    end
end
local function restoreInterface()
    for obj, props in pairs(savedInterface) do
        if obj and obj.Parent then
            for key, val in pairs(props) do
                pcall(function() obj[key] = val end)
            end
        end
        savedInterface[obj] = nil
    end
end
local function startSprint()
    if not Stamina.enabled then return end
    if sprinting and sprinting.Parent then pcall(function() sprinting.Value = true end) end
    applySpeedState()
    updateMobileInterface(true)
    sendSprint(true)
end
local function stopSprint()
    if sprinting and sprinting.Parent then pcall(function() sprinting.Value = false end) end
    updateMobileInterface(false)
    sendSprint(false)
    applySpeedState()
end
local function bindMobile()
    if not Stamina.enabled then return end
    local screen = PG:FindFirstChild("ScreenGui")
    local button = screen and screen:FindFirstChild("MobileRun")
    if not button or button == mobileButton then return end
    setCapturedEnabled(originalMobileConnections, true)
    table.clear(originalMobileConnections)
    if mobileConn then mobileConn:Disconnect() mobileConn = nil end
    mobileButton = button
    captureConnections(button.Activated, originalMobileConnections)
    mobileConn = conn(button.Activated, function()
        if not Stamina.enabled then return end
        mobileHeld = not mobileHeld
        if mobileHeld then startSprint() else stopSprint() end
    end, S.staminaConns)
    setCapturedEnabled(originalMobileConnections, false)
end
function Stamina:SetEnabled(value)
    if self.destroyed or self.enabled == value then return end
    self.enabled = value
    if value then
        if not humanoid or not humanoid.Parent then
            local char = LP.Character
            if char then refreshCharacter(char) end
        end
        findSprintEvent()
        if sprintEvent then
            captureConnections(sprintEvent.OnClientEvent, originalSprintConnections)
            setCapturedEnabled(originalSprintConnections, false)
        end
        bindMobile()
        if sprintWanted() then startSprint() end
    else
        sprintHeld, controllerHeld, mobileHeld = false, false, false
        stopSprint()
        setCapturedEnabled(originalSprintConnections, true)
        setCapturedEnabled(originalMobileConnections, true)
        table.clear(originalSprintConnections)
        table.clear(originalMobileConnections)
        if mobileConn then mobileConn:Disconnect() mobileConn = nil end
        mobileButton = nil
        restoreInterface()
    end
end
function Stamina:Destroy()
    if self.destroyed then return end
    if self.enabled then self:SetEnabled(false) end
    self.destroyed = true
    disconnect(S.staminaConns)
end
S.staminaController = Stamina
refreshCharacter(LP.Character)
conn(LP.CharacterAdded, function(char)
    refreshCharacter(char)
    if Stamina.enabled then
        task.defer(function() if not S.destroyed then bindMobile() end end)
    end
    if flags.ItemTracer then task.defer(resetWorld) end
end)
conn(PG.DescendantAdded, function(obj)
    if obj.Name == "MobileRun" and Stamina.enabled then
        task.defer(function() if not S.destroyed then bindMobile() end end)
    end
end)
conn(UIS.InputBegan, function(input, processed)
    if processed or not Stamina.enabled then return end
    if input.KeyCode == Enum.KeyCode.LeftShift then
        if not sprintHeld then sprintHeld = true startSprint() end
    elseif input.KeyCode == Enum.KeyCode.ButtonR1 then
        if not controllerHeld then controllerHeld = true startSprint() end
    end
end)
conn(UIS.InputEnded, function(input)
    if not Stamina.enabled then return end
    if input.KeyCode == Enum.KeyCode.LeftShift then sprintHeld = false
    elseif input.KeyCode == Enum.KeyCode.ButtonR1 then controllerHeld = false
    else return end
    if not (sprintHeld or controllerHeld or mobileHeld) then stopSprint() end
end)
local staminaToken = 0
local function runStaminaLoop()
    staminaToken += 1
    local token = staminaToken
    if not Stamina.enabled then return end
    task.spawn(function()
        while not S.destroyed and Stamina.enabled and token == staminaToken do
            if sprintWanted() then
                if sprinting and sprinting.Parent then
                    pcall(function() sprinting.Value = true end)
                end
                applySpeedState()
            end
            task.wait(.22)
        end
    end)
end

