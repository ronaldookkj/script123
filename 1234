local function conn(signal, fn, bucket)
    if S.destroyed or not signal then return nil end
    local ok, c = pcall(function() return signal:Connect(fn) end)
    if ok and c then table.insert(bucket or S.connections, c) return c end
    return nil
end
local function disconnect(bucket)
    for i = #bucket, 1, -1 do
        pcall(function() bucket[i]:Disconnect() end)
        bucket[i] = nil
    end
end
local function safeDestroy(obj)
    if obj then pcall(function() obj:Destroy() end) end
end
local function root(char)
    return char and (char:FindFirstChild("HumanoidRootPart")
        or char:FindFirstChild("UpperTorso") or char:FindFirstChild("Torso") or char.PrimaryPart)
end

-- ============================================================
-- FILTRO VISUAL VEE + ICHOR: UMA varredura limitada + eventos.
-- Não fica procurando na tela por segundo/frame.
-- Ao mudar nome da UI em atualizações, ampliar os nomes abaixo.
-- ============================================================
local EXTRA_VEE_NAMES = {
    veepopup = true, vee_popup = true, veead = true, vee_ad = true,
    veeadvertisement = true, veeadvert = true,
}
local EXTRA_ICHOR_NAMES = {
    ichorstain = true, ichorstains = true, ichorsplash = true,
    ichorsplatter = true, ichoroverlay = true, ichorscreen = true,
    ichorleakoverlay = true, ichorleakscreen = true, inksplash = true,
}
local watchGui = setmetatable({}, { __mode = "k" })
local function compact(s)
    return tostring(s or ""):lower():gsub("[%s%-%_]", "")
end
local function visualType(object)
    if not object:IsA("GuiObject") and not object:IsA("LayerCollector") then return nil end
    local name = compact(object.Name)
    if EXTRA_VEE_NAMES[name] or (name:find("vee", 1, true)
        and (name:find("popup", 1, true) or name:find("advert", 1, true)
        or name:find("adwindow", 1, true))) then return "HideVee" end
    if EXTRA_ICHOR_NAMES[name] or (name:find("ichor", 1, true)
        and (name:find("stain", 1, true) or name:find("splash", 1, true)
        or name:find("overlay", 1, true) or name:find("screen", 1, true))) then
        return "HideIchor"
    end
    -- Identifica popups chamados apenas 'Popup' quando estão no contêiner da Vee.
    if name == "popup" or name == "popupframe" or name == "advertisement" then
        local ancestor = object.Parent
        for _ = 1, 5 do
            if not ancestor or ancestor == PG then break end
            if compact(ancestor.Name):find("vee", 1, true) then return "HideVee" end
            ancestor = ancestor.Parent
        end
    end
    return nil
end
local function hideGui(obj, flag)
    if S.destroyed or not flags[flag] or not obj or not obj.Parent then return end
    pcall(function()
        if obj:IsA("GuiObject") then
            if obj.Visible then obj.Visible = false end
        elseif obj:IsA("LayerCollector") then
            if obj.Enabled then obj.Enabled = false end
        end
    end)
end
local function watchVisual(obj)
    if S.destroyed or not obj or watchGui[obj] then return end
    local flag = visualType(obj)
    if not flag then return end
    local bucket = {}
    watchGui[obj] = { flag = flag, conns = bucket }
    hideGui(obj, flag)
    local property = obj:IsA("GuiObject") and "Visible" or "Enabled"
    conn(obj:GetPropertyChangedSignal(property), function()
        hideGui(obj, flag)
    end, bucket)
    conn(obj.AncestryChanged, function(_, parent)
        if not parent and watchGui[obj] then
            disconnect(watchGui[obj].conns)
            watchGui[obj] = nil
        end
    end, bucket)
end
-- O loop abaixo ocorre APENAS UMA VEZ na inicialização, com teto de trabalho.
local scanList = { PG }
local scanIndex = 1
while scanIndex <= #scanList and scanIndex <= 800 do
    local parent = scanList[scanIndex]
    scanIndex += 1
    for _, obj in ipairs(parent:GetChildren()) do
        watchVisual(obj)
        if #scanList < 800 then table.insert(scanList, obj) end
    end
end
scanList = nil
conn(PG.DescendantAdded, watchVisual)

