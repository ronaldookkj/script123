local Players = game:GetService("Players")
local UIS = game:GetService("UserInputService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local LocalPlayer = Players.LocalPlayer
local CurrentRoom = workspace:WaitForChild("CurrentRoom")

local env = getgenv and getgenv() or _G
local KEY = "__ESP_4_CORES"

if env[KEY] and type(env[KEY].Destroy) == "function" then
    pcall(function()
        env[KEY]:Destroy()
    end)
end

local S = {
    destroyed = false,
    connections = {},
    highlights = {},
    billboards = {},
    rareBillboardController = nil,
    skillRemote = nil,
    originalSkillCallback = nil,
    skillEnabled = true,
    playerInfoEnabled = true,
    tracers = {},
    tracerAttachment = nil,
    gui = nil,
    originalLighting = nil
}

env[KEY] = S

local colors = {
    GeneratorESP = Color3.fromRGB(0, 170, 255),
    MonsterESP = Color3.fromRGB(255, 45, 45),
    PlayerESP = Color3.fromRGB(0, 255, 90),
    ItemESP = Color3.fromRGB(255, 225, 0)
}

local enabled = {
    GeneratorESP = true,
    MonsterESP = true,
    PlayerESP = true,
    ItemESP = true
}

local tracked = {
    GeneratorESP = setmetatable({}, {__mode = "k"}),
    MonsterESP = setmetatable({}, {__mode = "k"}),
    PlayerESP = setmetatable({}, {__mode = "k"}),
    ItemESP = setmetatable({}, {__mode = "k"})
}

local boundRooms = setmetatable({}, {__mode = "k"})
local boundFolders = setmetatable({}, {__mode = "k"})
local boundGenerators = setmetatable({}, {__mode = "k"})
local boundBlots = setmetatable({}, {__mode = "k"})
local boundPlayers = setmetatable({}, {__mode = "k"})

local function connect(signal, callback)
    if S.destroyed then return nil end
    local connection = signal:Connect(callback)
    table.insert(S.connections, connection)
    return connection
end

local function createHighlight(item, name, transparency)
    if S.destroyed or not item or not item.Parent then return nil end

    local highlightName = name == "PlayerESP"
        and "__DistrairPlayerHighlight" or name

    local h = item:FindFirstChild(highlightName)
    if not h or not h:IsA("Highlight") then
        h = Instance.new("Highlight")
        h.Name = highlightName
        h.Parent = item
    end

    h.Adornee = item
    h.FillColor = colors[name]
    h.OutlineColor = colors[name]
    h.FillTransparency = transparency
    h.OutlineTransparency = 0
    h.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
    h.Enabled = enabled[name]
    tracked[name][h] = true
    S.highlights[h] = true
    return h
end

local function addGenerator(item)
    if S.destroyed or not item or boundGenerators[item] then return end
    boundGenerators[item] = true

    local stats = item:FindFirstChild("Stats")
    local completed = stats and stats:FindFirstChild("Completed")
    if completed and completed.Value == true then return end

    local h = createHighlight(item, "GeneratorESP", 0.68)

    if completed then
        connect(completed:GetPropertyChangedSignal("Value"), function()
            if completed.Value == true and h and h.Parent then
                tracked.GeneratorESP[h] = nil
                h:Destroy()
            end
        end)
    end
end

local function onAdded(item)
    if S.destroyed or not item or not item.Parent then return end
    local parentName = item.Parent.Name

    if parentName == "Generators" or item.Name == "Generator" then
        addGenerator(item)
    elseif parentName == "Items" then
        if not item.Name:find("Capsule") then
            createHighlight(item, "ItemESP", 0.25)
        end
    elseif parentName == "Monsters" then
        createHighlight(item, "MonsterESP", 0.68)
    end
end

local function highlightBlotHand(hand)
    task.spawn(function()
        local arm = hand:WaitForChild("Arm", 5)
        if arm and not S.destroyed then
            createHighlight(arm, "MonsterESP", 0.68)
        end
    end)
end

local function bindBlot(entity)
    if not entity:IsA("Part")
        or not entity.Name:find("BlotHandZone")
        or boundBlots[entity] then return end

    boundBlots[entity] = true
    connect(entity.ChildAdded, function(child)
        if child:IsA("Model") then
            highlightBlotHand(child)
        end
    end)

    for _, child in ipairs(entity:GetChildren()) do
        if child:IsA("Model") then
            highlightBlotHand(child)
        end
    end
end

local function bindFolder(folder)
    if boundFolders[folder] then return end
    boundFolders[folder] = true
    connect(folder.ChildAdded, onAdded)
    for _, item in ipairs(folder:GetChildren()) do
        onAdded(item)
    end
end

local function bindRoomChild(child)
    if child.Name == "Monsters"
        or child.Name == "Generators"
        or child.Name == "Items" then
        bindFolder(child)
    end
    if child.Name == "Generator" then
        onAdded(child)
    end
    bindBlot(child)
end

local function bindRoom(room)
    if not room:IsA("Model") or boundRooms[room] then return end
    boundRooms[room] = true
    connect(room.ChildAdded, bindRoomChild)
    for _, child in ipairs(room:GetChildren()) do
        bindRoomChild(child)
    end
end

local function getRoot(char)
    return char and (
        char:FindFirstChild("HumanoidRootPart")
        or char:FindFirstChild("UpperTorso")
        or char:FindFirstChild("Torso")
        or char.PrimaryPart
    )
end

local function createPlayerBillboard(player, root)
    local name = "__DistrairPlayerBillboard"
    local bill = root:FindFirstChild(name)
    if not bill or not bill:IsA("BillboardGui") then
        bill = Instance.new("BillboardGui")
        bill.Name = name
        bill.Parent = root
    end

    bill.Adornee = root
    bill.AlwaysOnTop = true
    bill.LightInfluence = 0
    bill.MaxDistance = 0
    bill.Size = UDim2.fromOffset(155, 44)
    bill.StudsOffsetWorldSpace = Vector3.new(0, 3.2, 0)
    bill.Enabled = enabled.PlayerESP and S.playerInfoEnabled

    local holder = bill:FindFirstChild("Holder")
    if not holder then
        holder = Instance.new("Frame")
        holder.Name = "Holder"
        holder.Parent = bill
    end

    holder.Size = UDim2.fromScale(1, 1)
    holder.BackgroundColor3 = Color3.fromRGB(12, 12, 14)
    holder.BackgroundTransparency = 0.35
    holder.BorderSizePixel = 0

    if not holder:FindFirstChildOfClass("UICorner") then
        local corner = Instance.new("UICorner")
        corner.CornerRadius = UDim.new(0, 5)
        corner.Parent = holder
    end

    local stroke = holder:FindFirstChildOfClass("UIStroke")
    if not stroke then
        stroke = Instance.new("UIStroke")
        stroke.Parent = holder
    end
    stroke.Color = colors.PlayerESP
    stroke.Thickness = 1
    stroke.Transparency = 0.15

    local function label(labelName, y, height, size, font)
        local obj = holder:FindFirstChild(labelName)
        if not obj or not obj:IsA("TextLabel") then
            obj = Instance.new("TextLabel")
            obj.Name = labelName
            obj.Parent = holder
        end
        obj.BackgroundTransparency = 1
        obj.Position = UDim2.fromOffset(3, y)
        obj.Size = UDim2.new(1, -6, 0, height)
        obj.Font = font
        obj.TextSize = size
        obj.TextStrokeTransparency = 0.45
        return obj
    end

    local nameLabel = label("Name", 1, 20, 12, Enum.Font.GothamBold)
    nameLabel.TextColor3 = colors.PlayerESP
    nameLabel.Text = player.DisplayName ~= player.Name
        and (player.DisplayName .. " @" .. player.Name)
        or player.Name

    local info = label("Info", 20, 18, 10, Enum.Font.Gotham)
    info.TextColor3 = Color3.fromRGB(245, 245, 245)
    S.billboards[bill] = true
    return info
end

local function updatePlayer(player)
    if S.destroyed or player == LocalPlayer then return end
    local char = player.Character
    local root = getRoot(char)
    if not char or not root then return end

    createHighlight(char, "PlayerESP", 0.78)
    local info = createPlayerBillboard(player, root)
    local myRoot = getRoot(LocalPlayer.Character)
    local hum = char:FindFirstChildOfClass("Humanoid")

    if info and myRoot then
        local distance = math.floor((root.Position - myRoot.Position).Magnitude + 0.5)
        local hp = hum and math.floor(hum.Health + 0.5) or 0
        info.Text = tostring(distance) .. "m | HP " .. tostring(hp)
    end
end

local function bindPlayer(player)
    if player == LocalPlayer or boundPlayers[player] then return end
    boundPlayers[player] = true
    connect(player.CharacterAdded, function()
        task.wait(0.35)
        if not S.destroyed then updatePlayer(player) end
    end)
    updatePlayer(player)
end

local function toggleESP(name)
    enabled[name] = not enabled[name]
    for h in pairs(tracked[name]) do
        if h and h.Parent then
            h.Enabled = enabled[name]
            h.FillColor = colors[name]
            h.OutlineColor = colors[name]
            h.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
        else
            tracked[name][h] = nil
        end
    end
    if name == "PlayerESP" then
        for bill in pairs(S.billboards) do
            if bill and bill.Parent then
                bill.Enabled = enabled.PlayerESP and S.playerInfoEnabled
            else
                S.billboards[bill] = nil
            end
        end
    end
end

local function supercompleteCallback(...)
    return "supercomplete"
end

local function setSkillEnabled(value)
    S.skillEnabled = value
    if not S.skillRemote then return end

    local ok, err = pcall(function()
        S.skillRemote.OnClientInvoke = value
            and supercompleteCallback
            or S.originalSkillCallback
    end)
    if not ok then
        warn("Auto Skill Check: " .. tostring(err))
    end
end

function S:Destroy()
    if self.destroyed then return end
    self.destroyed = true

    if self.gui then pcall(function() self.gui:Destroy() end) end
    if self.tracerAttachment then pcall(function() self.tracerAttachment:Destroy() end) end
    for _, beam in pairs(self.tracers) do pcall(function() beam:Destroy() end) end
    if self.originalLighting then
        local lighting = game:GetService("Lighting")
        for property, value in pairs(self.originalLighting) do pcall(function() lighting[property] = value end) end
    end
    if self.rareBillboardController then
        pcall(function() self.rareBillboardController:Destroy() end)
        self.rareBillboardController = nil
    end

    for _, connection in ipairs(self.connections) do
        pcall(function() connection:Disconnect() end)
    end
    for h in pairs(self.highlights) do
        pcall(function() h:Destroy() end)
    end
    for bill in pairs(self.billboards) do
        pcall(function() bill:Destroy() end)
    end
    if self.skillRemote then
        pcall(function()
            self.skillRemote.OnClientInvoke = self.originalSkillCallback
        end)
    end
    if env[KEY] == self then env[KEY] = nil end
end

for _, room in ipairs(CurrentRoom:GetChildren()) do
    bindRoom(room)
end
connect(CurrentRoom.ChildAdded, bindRoom)

for _, player in ipairs(Players:GetPlayers()) do
    bindPlayer(player)
end
connect(Players.PlayerAdded, bindPlayer)


task.spawn(function()
    while not S.destroyed do
        if enabled.PlayerESP then
            for _, player in ipairs(Players:GetPlayers()) do
                updatePlayer(player)
            end
        end
        task.wait(1)
    end
end)

task.spawn(function()
    local events = ReplicatedStorage:WaitForChild("Events", 10)
    if S.destroyed or not events then return end

    local remote = events:WaitForChild("SkillcheckUpdate", 10)
    if S.destroyed or not remote or not remote:IsA("RemoteFunction") then
        warn("Auto Skill Check: SkillcheckUpdate indisponivel")
        return
    end

    S.skillRemote = remote
    local original = nil
    if type(getcallbackvalue) == "function" then
        local ok, callback = pcall(getcallbackvalue, remote, "OnClientInvoke")
        if ok and type(callback) == "function" then
            original = callback
        end
    end
    if not original then
        local ok, callback = pcall(function()
            return remote.OnClientInvoke
        end)
        if ok and type(callback) == "function" then
            original = callback
        end
    end
    S.originalSkillCallback = original
    setSkillEnabled(S.skillEnabled)
end)

-- Billboard de cooldown para Scraps, Goob e Gigi (do segundo script).
-- Separado do billboard de jogadores e integrado ao ciclo de vida do ESP.
do
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
local Workspace = game:GetService("Workspace")

local LocalPlayer = Players.LocalPlayer
local TOGGLE_KEY = Enum.KeyCode.KeypadSix
local BILLBOARD_NAME = "__RareGrabCooldownBillboard"

local MONSTER_CONFIG = {
    ScrapsMonster = {
        displayName = "SCRAPS",
        cooldown = 12,
        readyText = "GRAB READY",
        activeText = "GRABBING",
        windupTimeout = 2.5,
    },

    GoobMonster = {
        displayName = "GOOB",
        cooldown = 10,
        readyText = "GRAB READY",
        activeText = "GRABBING",
        windupTimeout = 2.0,
    },

    GigiMonster = {
        displayName = "GIGI",
        cooldown = 10,
        readyText = "STEAL READY",
        activeText = "STEALING",
        windupTimeout = 2.0,
    },
}

local COLORS = {
    READY = Color3.fromRGB(255, 90, 90),
    WINDUP = Color3.fromRGB(255, 215, 70),
    ACTIVE = Color3.fromRGB(255, 80, 170),
    COOLDOWN = Color3.fromRGB(100, 220, 255),
}

local environment = getgenv and getgenv() or _G

if environment.__RARE_GRAB_BILLBOARDS
    and environment.__RARE_GRAB_BILLBOARDS.Destroy then

    pcall(function()
        environment.__RARE_GRAB_BILLBOARDS:Destroy()
    end)
end

local Controller = {
    enabled = true,
    destroyed = false,
    connections = {},
    trackers = setmetatable({}, { __mode = "k" }),
}

environment.__RARE_GRAB_BILLBOARDS = Controller
S.rareBillboardController = Controller

local pendingMonsters = setmetatable({}, { __mode = "k" })

local function disconnectList(list)
    for _, connection in ipairs(list) do
        pcall(function()
            connection:Disconnect()
        end)
    end

    table.clear(list)
end

function Controller:Connect(signal, callback, list)
    local connection = signal:Connect(callback)
    table.insert(list or self.connections, connection)
    return connection
end

local function normalizeAnimationId(animationId)
    return tostring(animationId):match("%d+") or ""
end

local function lower(text)
    return string.lower(tostring(text))
end

local function isInsideCurrentRoom(object)
    local currentRoom = Workspace:FindFirstChild("CurrentRoom")

    return currentRoom ~= nil
        and object ~= nil
        and object:IsDescendantOf(currentRoom)
end

local function isTargetMonster(object)
    if not object
        or not object:IsA("Model")
        or not MONSTER_CONFIG[object.Name]
        or not object.Parent
        or object.Parent.Name ~= "Monsters" then

        return false
    end

    return isInsideCurrentRoom(object)
end

local function findAnchor(monster, waitTime)
    local anchor = monster:FindFirstChild("Head")
        or monster:FindFirstChild("HumanoidRootPart")
        or monster:FindFirstChildWhichIsA("BasePart", true)

    if anchor then
        return anchor
    end

    if waitTime and waitTime > 0 then
        anchor = monster:WaitForChild("HumanoidRootPart", waitTime)

        if anchor and anchor:IsA("BasePart") then
            return anchor
        end
    end

    return monster:FindFirstChild("Head")
        or monster:FindFirstChild("HumanoidRootPart")
        or monster:FindFirstChildWhichIsA("BasePart", true)
end

local function calculateOffset(monster, anchor)
    if anchor and anchor.Name == "Head" then
        return Vector3.new(0, 3.25, 0)
    end

    local success, size = pcall(function()
        return monster:GetExtentsSize()
    end)

    if success then
        return Vector3.new(0, math.max(4, size.Y * 0.5 + 1.75), 0)
    end

    return Vector3.new(0, 5, 0)
end

local function createBillboard(monster, config)
    local old = monster:FindFirstChild(BILLBOARD_NAME, true)

    if old then
        old:Destroy()
    end

    local anchor = findAnchor(monster, 6)

    if not anchor then
        return nil
    end

    local billboard = Instance.new("BillboardGui")
    billboard.Name = BILLBOARD_NAME
    billboard.Adornee = anchor
    billboard.AlwaysOnTop = true
    billboard.LightInfluence = 0
    billboard.MaxDistance = 0
    billboard.Size = UDim2.fromOffset(134, 43)
    billboard.StudsOffsetWorldSpace = calculateOffset(monster, anchor)
    billboard.Enabled = Controller.enabled
    billboard.Parent = anchor

    local frame = Instance.new("Frame")
    frame.Name = "Container"
    frame.Size = UDim2.fromScale(1, 1)
    frame.BackgroundColor3 = Color3.fromRGB(14, 14, 18)
    frame.BackgroundTransparency = 0.16
    frame.BorderSizePixel = 0
    frame.Parent = billboard

    local corner = Instance.new("UICorner")
    corner.CornerRadius = UDim.new(0, 5)
    corner.Parent = frame

    local stroke = Instance.new("UIStroke")
    stroke.Name = "StateStroke"
    stroke.Thickness = 1
    stroke.Transparency = 0.1
    stroke.Color = COLORS.READY
    stroke.Parent = frame

    local title = Instance.new("TextLabel")
    title.Name = "MonsterName"
    title.BackgroundTransparency = 1
    title.Position = UDim2.fromOffset(3, 2)
    title.Size = UDim2.new(1, -6, 0, 15)
    title.Font = Enum.Font.GothamBold
    title.Text = config.displayName
    title.TextColor3 = Color3.fromRGB(235, 235, 240)
    title.TextSize = 10
    title.TextStrokeTransparency = 0.7
    title.Parent = frame

    local state = Instance.new("TextLabel")
    state.Name = "State"
    state.BackgroundTransparency = 1
    state.Position = UDim2.fromOffset(3, 14)
    state.Size = UDim2.new(1, -6, 0, 24)
    state.Font = Enum.Font.GothamBlack
    state.Text = config.readyText
    state.TextColor3 = COLORS.READY
    state.TextSize = 13
    state.TextStrokeColor3 = Color3.new(0, 0, 0)
    state.TextStrokeTransparency = 0.35
    state.Parent = frame

    return {
        gui = billboard,
        frame = frame,
        stroke = stroke,
        title = title,
        stateLabel = state,
    }
end

local function applyVisual(tracker, text, color)
    if not tracker.visual
        or not tracker.visual.gui
        or not tracker.visual.gui.Parent then

        return
    end

    tracker.visual.stateLabel.Text = text
    tracker.visual.stateLabel.TextColor3 = color
    tracker.visual.stroke.Color = color
end

local function setState(tracker, newState)
    if not tracker or tracker.destroyed then
        return
    end

    tracker.state = newState

    if newState == "READY" then
        tracker.windupDeadline = nil
        tracker.cooldownEndsAt = nil
        applyVisual(tracker, tracker.config.readyText, COLORS.READY)

    elseif newState == "WINDUP" then
        tracker.windupDeadline = os.clock()
            + (tracker.config.windupTimeout or 2.5)

        applyVisual(tracker, "WINDUP", COLORS.WINDUP)

    elseif newState == "ACTIVE" then
        tracker.windupDeadline = nil
        applyVisual(tracker, tracker.config.activeText, COLORS.ACTIVE)

    elseif newState == "COOLDOWN" then
        tracker.windupDeadline = nil

        local remaining = math.max(
            0,
            (tracker.cooldownEndsAt or os.clock()) - os.clock()
        )

        applyVisual(
            tracker,
            string.format("%.1fs", remaining),
            COLORS.COOLDOWN
        )
    end
end

local function startCooldown(tracker)
    if not tracker or tracker.destroyed then
        return
    end

    tracker.windupDeadline = nil
    tracker.cooldownEndsAt = os.clock() + tracker.config.cooldown
    setState(tracker, "COOLDOWN")
end

local function buildAnimationMap(monster)
    local animationMap = {}

    for _, object in ipairs(monster:GetDescendants()) do
        if object:IsA("Animation") then
            local id = normalizeAnimationId(object.AnimationId)
            local name = lower(object.Name)

            if id ~= "" then
                if string.find(name, "windup", 1, true) then
                    animationMap[id] = "WINDUP"
                elseif name == "grab"
                    or string.find(name, "rangedgrab", 1, true)
                    or string.find(name, "steal", 1, true) then

                    animationMap[id] = "WINDUP"
                end
            end
        end
    end

    return animationMap
end

local function bindAnimator(tracker, animator)
    if not animator
        or not animator:IsA("Animator")
        or tracker.boundAnimators[animator] then

        return
    end

    tracker.boundAnimators[animator] = true

    Controller:Connect(
        animator.AnimationPlayed,
        function(track)
            if tracker.destroyed then
                return
            end

            local animation = track.Animation
            local animationId = animation
                and normalizeAnimationId(animation.AnimationId)
                or ""

            local animationName = lower(
                animation and animation.Name or track.Name
            )

            local classifiedState = tracker.animationMap[animationId]

            if not classifiedState then
                if string.find(animationName, "windup", 1, true)
                    or animationName == "grab"
                    or string.find(animationName, "rangedgrab", 1, true)
                    or string.find(animationName, "steal", 1, true) then

                    classifiedState = "WINDUP"
                end
            end

            if classifiedState == "WINDUP"
                and tracker.state ~= "ACTIVE" then

                setState(tracker, "WINDUP")
            end
        end,
        tracker.connections
    )
end

local function cleanupTracker(tracker)
    if not tracker or tracker.destroyed then
        return
    end

    tracker.destroyed = true
    disconnectList(tracker.connections)

    if tracker.visual
        and tracker.visual.gui
        and tracker.visual.gui.Parent then

        tracker.visual.gui:Destroy()
    end

    Controller.trackers[tracker.monster] = nil
end

local function trackMonster(monster)
    if Controller.destroyed
        or not isTargetMonster(monster)
        or Controller.trackers[monster]
        or pendingMonsters[monster] then

        return
    end

    pendingMonsters[monster] = true

    task.spawn(function()
        if not monster.Parent or not isTargetMonster(monster) then
            pendingMonsters[monster] = nil
            return
        end

        local config = MONSTER_CONFIG[monster.Name]
        local visual = createBillboard(monster, config)

        if Controller.destroyed then
            pendingMonsters[monster] = nil
            if visual and visual.gui then
                visual.gui:Destroy()
            end
            return
        end

        if not visual then
            pendingMonsters[monster] = nil

            if monster.Parent and isTargetMonster(monster) then
                task.delay(1, function()
                    trackMonster(monster)
                end)
            end

            return
        end

        local tracker = {
            monster = monster,
            config = config,
            visual = visual,
            state = "READY",
            cooldownEndsAt = nil,
            windupDeadline = nil,
            wasGrabbing = false,
            destroyed = false,
            connections = {},
            boundAnimators = setmetatable({}, { __mode = "k" }),
            animationMap = buildAnimationMap(monster),
        }

        Controller.trackers[monster] = tracker
        pendingMonsters[monster] = nil

        local grabbing = monster:FindFirstChild("Grabbing")
            or monster:WaitForChild("Grabbing", 5)

        if grabbing and grabbing:IsA("BoolValue") then
            tracker.wasGrabbing = grabbing.Value

            if grabbing.Value then
                setState(tracker, "ACTIVE")
            else
                setState(tracker, "READY")
            end

            Controller:Connect(
                grabbing:GetPropertyChangedSignal("Value"),
                function()
                    if tracker.destroyed then
                        return
                    end

                    local isGrabbing = grabbing.Value

                    if isGrabbing then
                        tracker.windupDeadline = nil
                        tracker.cooldownEndsAt = nil
                        setState(tracker, "ACTIVE")
                    elseif tracker.wasGrabbing then
                        startCooldown(tracker)
                    end

                    tracker.wasGrabbing = isGrabbing
                end,
                tracker.connections
            )
        else
            setState(tracker, "READY")
        end

        local chasing = monster:FindFirstChild("Chasing")

        if chasing and chasing:IsA("BoolValue") then
            Controller:Connect(
                chasing:GetPropertyChangedSignal("Value"),
                function()
                    if tracker.destroyed then
                        return
                    end

                    if not chasing.Value
                        and tracker.state == "WINDUP"
                        and not (grabbing and grabbing.Value) then

                        startCooldown(tracker)
                    end
                end,
                tracker.connections
            )
        end

        local animator = monster:FindFirstChildWhichIsA("Animator", true)

        if animator then
            bindAnimator(tracker, animator)
        end

        Controller:Connect(
            monster.DescendantAdded,
            function(object)
                if tracker.destroyed then
                    return
                end

                if object:IsA("Animator") then
                    bindAnimator(tracker, object)
                end

                if object:IsA("Animation") then
                    local id = normalizeAnimationId(object.AnimationId)
                    local name = lower(object.Name)

                    if id ~= "" then
                        if string.find(name, "windup", 1, true)
                            or name == "grab"
                            or string.find(name, "rangedgrab", 1, true)
                            or string.find(name, "steal", 1, true) then

                            tracker.animationMap[id] = "WINDUP"
                        end
                    end
                end

                local objectName = lower(object.Name)

                if string.find(
                    objectName,
                    "rangedwindupsound",
                    1,
                    true
                ) then
                    if tracker.state ~= "ACTIVE" then
                        setState(tracker, "WINDUP")
                    end
                end
            end,
            tracker.connections
        )

        Controller:Connect(
            monster.AncestryChanged,
            function()
                if tracker.destroyed then
                    return
                end

                if not monster.Parent
                    or not isInsideCurrentRoom(monster) then

                    cleanupTracker(tracker)
                end
            end,
            tracker.connections
        )

    end)
end

function Controller:SetEnabled(enabled)
    self.enabled = enabled

    for _, tracker in pairs(self.trackers) do
        if tracker.visual
            and tracker.visual.gui
            and tracker.visual.gui.Parent then

            tracker.visual.gui.Enabled = enabled
        end
    end

end

function Controller:Destroy()
    if self.destroyed then
        return
    end

    self.destroyed = true

    for _, tracker in pairs(self.trackers) do
        cleanupTracker(tracker)
    end

    disconnectList(self.connections)

    if environment.__RARE_GRAB_BILLBOARDS == self then
        environment.__RARE_GRAB_BILLBOARDS = nil
    end
end


