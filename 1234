local billboardUpdateAccumulator = 0

Controller:Connect(
    RunService.Heartbeat,
    function(deltaTime)
        if Controller.destroyed then
            return
        end

        billboardUpdateAccumulator += deltaTime

        if billboardUpdateAccumulator < 0.10 then
            return
        end

        billboardUpdateAccumulator = 0

        local now = os.clock()

        for monster, tracker in pairs(Controller.trackers) do
            if tracker.destroyed or not monster.Parent then
                cleanupTracker(tracker)

            elseif tracker.state == "WINDUP"
                and tracker.windupDeadline
                and now >= tracker.windupDeadline then

                local grabbing = monster:FindFirstChild("Grabbing")

                if grabbing
                    and grabbing:IsA("BoolValue")
                    and grabbing.Value then

                    setState(tracker, "ACTIVE")
                else
                    startCooldown(tracker)
                end

            elseif tracker.state == "COOLDOWN" then
                local remaining =
                    (tracker.cooldownEndsAt or 0) - now

                if remaining <= 0 then
                    setState(tracker, "READY")
                else
                    applyVisual(
                        tracker,
                        string.format("%.1fs", remaining),
                        COLORS.COOLDOWN
                    )
                end
            end
        end
    end
)
