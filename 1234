-- EXTRAS VISUAIS: só executados quando o usuário habilitar
-- ============================================================
local cam = WS.CurrentCamera
local originalFOV = cam and cam.FieldOfView or 70
local targetFOV = math.clamp(math.floor(originalFOV + .5), 40, 120)
local originalLighting = {}
for _, prop in ipairs({"Brightness", "ClockTime", "FogEnd", "GlobalShadows", "Ambient"}) do
    originalLighting[prop] = Lighting[prop]
end
local function applyLighting()
    if flags.FullBright then
        Lighting.Brightness = 3
        Lighting.ClockTime = 14
        Lighting.FogEnd = 100000
        Lighting.GlobalShadows = false
        Lighting.Ambient = Color3.fromRGB(170, 170, 170)
    else
        for prop, val in pairs(originalLighting) do
            pcall(function() Lighting[prop] = val end)
        end
    end
end
local function applyFOV()
    local camera = WS.CurrentCamera
    if camera and flags.FOV and math.abs(camera.FieldOfView - targetFOV) > .05 then
        camera.FieldOfView = targetFOV
    end
end
local extraToken = 0
local function updateExtras()
    extraToken += 1
    local token = extraToken
    if not (flags.FullBright or flags.FOV) then return end
    task.spawn(function()
        while not S.destroyed and token == extraToken
            and (flags.FullBright or flags.FOV) do
            if flags.FullBright then applyLighting() end
            if flags.FOV then applyFOV() end
            task.wait(.6)
        end
    end)
end

local function setFlag(key, val)
    if flags[key] == nil or flags[key] == val or S.destroyed then return end
    flags[key] = val
    if key == "GeneratorESP" or key == "MonsterESP" or key == "ItemESP"
        or key == "ItemTracer" or key == "RareBillboard" then
        resetWorld()
    elseif key == "PlayerESP" or key == "PlayerInfo" then
        resetPlayers()
    elseif key == "AutoSkill" then
        setSkill(val)
    elseif key == "InfiniteStamina" then
        Stamina:SetEnabled(val)
        runStaminaLoop()
    elseif key == "FullBright" then
        applyLighting()
        updateExtras()
    elseif key == "FOV" then
        if not val and WS.CurrentCamera then WS.CurrentCamera.FieldOfView = originalFOV end
        updateExtras()
    elseif (key == "HideVee" or key == "HideIchor") and val then
        for obj, watch in pairs(watchGui) do
            if watch.flag == key then hideGui(obj, key) end
        end
    end
    print("[DW] " .. key .. ": " .. (val and "ON" or "OFF"))
end

function S:Destroy()
    if self.destroyed then return end
    self.destroyed = true
    -- Restaura callbacks e conexão desabilitada mesmo ao sair.
    Stamina:Destroy()
    setSkill(false)
    disconnect(self.roomConns)
    disconnect(self.playerConns)
    disconnect(self.connections)
    removeWorldVisuals()
    removePlayerVisuals()
    clearGrabbers()
    clearTracers()
    for obj, watch in pairs(watchGui) do
        disconnect(watch.conns)
        watchGui[obj] = nil
    end
    flags.FullBright = false
    applyLighting()
    if flags.FOV and WS.CurrentCamera then WS.CurrentCamera.FieldOfView = originalFOV end
    if self.ui then safeDestroy(self.ui) end
    if env[KEY] == self then env[KEY] = nil end
end

