local function worldNeeded()
    return flags.GeneratorESP or flags.MonsterESP or flags.ItemESP
        or flags.ItemTracer or flags.RareBillboard
end
local function getCurrentRoom()
    return WS:FindFirstChild("CurrentRoom")
end
local function newHighlight(obj, kind, alpha)
    if S.destroyed or not obj or not obj.Parent or not flags[kind] then return end
    if not (obj:IsA("Model") or obj:IsA("BasePart")) then
        obj = obj:FindFirstChildWhichIsA("Model", true) or obj:FindFirstChildWhichIsA("BasePart", true)
    end
    if not obj then return end
    local id = "__DWLeve" .. kind
    local h = obj:FindFirstChild(id)
    if not h then
        h = Instance.new("Highlight")
        h.Name = id
        h.Adornee = obj
        h.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
        h.FillTransparency = alpha
        h.OutlineTransparency = 0
        h.FillColor = colors[kind]
        h.OutlineColor = colors[kind]
        h.Parent = obj
    end
    S.worldObjects[h] = true
end
local function removeWorldVisuals()
    for h in pairs(S.worldObjects) do safeDestroy(h) S.worldObjects[h] = nil end
end
local function clearTracers()
    for item, entry in pairs(S.tracers) do
        safeDestroy(entry.beam)
        safeDestroy(entry.target)
        S.tracers[item] = nil
    end
    if S.tracerOrigin then safeDestroy(S.tracerOrigin) S.tracerOrigin = nil end
end
local function attachTracer(item)
    if not flags.ItemTracer or not item or not item.Parent or S.tracers[item] then return end
    local myRoot = root(LP.Character)
    if not myRoot then return end
    local part = item:IsA("BasePart") and item
        or (item:IsA("Model") and (item.PrimaryPart or item:FindFirstChildWhichIsA("BasePart", true)))
        or item:FindFirstChildWhichIsA("BasePart", true)
    if not part then return end
    if not S.tracerOrigin or S.tracerOrigin.Parent ~= myRoot then
        clearTracers()
        S.tracerOrigin = Instance.new("Attachment")
        S.tracerOrigin.Name = "__DWLeveOrigin"
        S.tracerOrigin.Parent = myRoot
    end
    local target = Instance.new("Attachment")
    target.Name = "__DWLeveTracerTarget"
    target.Parent = part
    local beam = Instance.new("Beam")
    beam.Name = "__DWLeveTracer"
    beam.Attachment0 = S.tracerOrigin
    beam.Attachment1 = target
    beam.FaceCamera = true
    beam.Width0, beam.Width1 = 0.055, 0.055
    beam.Transparency = NumberSequence.new(0.12)
    beam.Color = ColorSequence.new(colors.ItemESP)
    beam.LightEmission = 1
    beam.Parent = target
    S.tracers[item] = { beam = beam, target = target }
end

-- ============================================================
-- GRABBER: só rastreia se o botão estiver ligado
-- ============================================================
local GRABBERS = {
    ScrapsMonster = { "SCRAPS", 12 },
    GoobMonster = { "GOOB", 10 },
    GigiMonster = { "GIGI", 10 },
}
local function clearGrabbers()
    for monster, t in pairs(S.grabbers) do
        t.dead = true
        disconnect(t.conns)
        safeDestroy(t.gui)
        S.grabbers[monster] = nil
    end
end
local function trackGrabber(monster)
    if not flags.RareBillboard or not monster:IsA("Model") or S.grabbers[monster] then return end
    local config = GRABBERS[monster.Name]
    if not config then return end
    local anchor = monster:FindFirstChild("Head", true)
        or monster:FindFirstChild("HumanoidRootPart", true)
        or monster:FindFirstChildWhichIsA("BasePart", true)
    if not anchor then return end
    local g = Instance.new("BillboardGui")
    g.Name = "__DWLeveGrabber"
    g.Adornee = anchor
    g.AlwaysOnTop = true
    g.Size = UDim2.fromOffset(140, 44)
    g.StudsOffsetWorldSpace = Vector3.new(0, 4.5, 0)
    g.Parent = anchor
    local f = Instance.new("Frame")
    f.Size = UDim2.fromScale(1, 1)
    f.BackgroundColor3 = Color3.fromRGB(14, 14, 18)
    f.BackgroundTransparency = .12
    f.Parent = g
    Instance.new("UICorner", f).CornerRadius = UDim.new(0, 6)
    local nameLabel = Instance.new("TextLabel")
    nameLabel.Size = UDim2.new(1, 0, 0, 17)
    nameLabel.BackgroundTransparency = 1
    nameLabel.Text = config[1]
    nameLabel.TextColor3 = Color3.fromRGB(255, 255, 255)
    nameLabel.Font = Enum.Font.GothamBold
    nameLabel.TextSize = 11
    nameLabel.Parent = f
    local status = Instance.new("TextLabel")
    status.Position = UDim2.fromOffset(0, 17)
    status.Size = UDim2.new(1, 0, 0, 24)
    status.BackgroundTransparency = 1
    status.TextColor3 = Color3.fromRGB(140, 235, 150)
    status.Font = Enum.Font.GothamBold
    status.TextSize = 13
    status.Text = "GRAB READY"
    status.Parent = f
    local t = { gui = g, status = status, conns = {}, dead = false, seq = 0 }
    S.grabbers[monster] = t
    local function setState(textValue, color)
        if t.dead or not status.Parent then return end
        status.Text = textValue
        status.TextColor3 = color
    end
    local grabbing = monster:FindFirstChild("Grabbing", true)
    if grabbing and grabbing:IsA("BoolValue") then
        local wasActive = grabbing.Value
        if wasActive then setState("GRABBING", Color3.fromRGB(215, 150, 255)) end
        conn(grabbing:GetPropertyChangedSignal("Value"), function()
            if t.dead then return end
            if grabbing.Value then
                wasActive = true
                t.seq += 1
                setState("GRABBING", Color3.fromRGB(215, 150, 255))
            elseif wasActive then
                wasActive = false
                t.seq += 1
                local id = t.seq
                local untilTime = os.clock() + config[2]
                task.spawn(function()
                    while not t.dead and flags.RareBillboard and t.seq == id and os.clock() < untilTime do
                        setState(string.format("%.1fs", math.max(0, untilTime - os.clock())), Color3.fromRGB(130, 195, 255))
                        task.wait(0.2)
                    end
                    if not t.dead and t.seq == id then
                        setState("GRAB READY", Color3.fromRGB(140, 235, 150))
                    end
                end)
            end
        end, t.conns)
    end
    conn(monster.AncestryChanged, function(_, parent)
        if not parent then
            t.dead = true
            disconnect(t.conns)
            safeDestroy(g)
            S.grabbers[monster] = nil
        end
    end, t.conns)
end

local function onRoomItem(item)
    if S.destroyed or not item or not item.Parent then return end
    local pn = item.Parent.Name
    if pn == "Monsters" and item:IsA("Model") then
        if flags.MonsterESP then newHighlight(item, "MonsterESP", 0.68) end
        if flags.RareBillboard then trackGrabber(item) end
    elseif pn == "Items" and not item.Name:find("Capsule") then
        if flags.ItemESP then newHighlight(item, "ItemESP", 0.25) end
        attachTracer(item)
    elseif pn == "Generators" or item.Name == "Generator" then
        if not flags.GeneratorESP then return end
        local stats = item:FindFirstChild("Stats")
        local complete = stats and stats:FindFirstChild("Completed")
        if complete and complete.Value then return end
        newHighlight(item, "GeneratorESP", 0.68)
        if complete then
            conn(complete:GetPropertyChangedSignal("Value"), function()
                if complete.Value then
                    local h = item:FindFirstChild("__DWLeveGeneratorESP")
                    if h then
                        safeDestroy(h)
                        S.worldObjects[h] = nil
                    end
                end
            end, S.roomConns)
        end
    end
end
local function bindRoomFolder(folder)
    if folder.Name ~= "Generators" and folder.Name ~= "Monsters" and folder.Name ~= "Items" then return end
    conn(folder.ChildAdded, onRoomItem, S.roomConns)
    for _, item in ipairs(folder:GetChildren()) do onRoomItem(item) end
end
local function bindBlotZone(obj)
    if not flags.MonsterESP or not obj:IsA("BasePart")
        or not obj.Name:find("BlotHandZone", 1, true) then return end
    local function addHand(hand)
        if not hand:IsA("Model") then return end
        task.spawn(function()
            local arm = hand:FindFirstChild("Arm") or hand:WaitForChild("Arm", 4)
            if arm and flags.MonsterESP and not S.destroyed then
                newHighlight(arm, "MonsterESP", 0.68)
            end
        end)
    end
    conn(obj.ChildAdded, addHand, S.roomConns)
    for _, hand in ipairs(obj:GetChildren()) do addHand(hand) end
end
local function bindRoom(room)
    if S.destroyed or not (room:IsA("Model") or room:IsA("Folder")) then return end
    conn(room.ChildAdded, function(child)
        if child.Name == "Generators" or child.Name == "Monsters" or child.Name == "Items" then
            bindRoomFolder(child)
        else
            onRoomItem(child)
            bindBlotZone(child)
        end
    end, S.roomConns)
    for _, child in ipairs(room:GetChildren()) do
        if child.Name == "Generators" or child.Name == "Monsters" or child.Name == "Items" then
            bindRoomFolder(child)
        else
            onRoomItem(child)
            bindBlotZone(child)
        end
    end
end
local function resetWorld()
    disconnect(S.roomConns)
    removeWorldVisuals()
    clearGrabbers()
    clearTracers()
    if not worldNeeded() then return end
    local function bindCurrent(current)
        if not current or S.destroyed or not worldNeeded() then return end
        conn(current.ChildAdded, bindRoom, S.roomConns)
        for _, room in ipairs(current:GetChildren()) do bindRoom(room) end
    end
    conn(WS.ChildAdded, function(obj)
        if obj.Name == "CurrentRoom" then bindCurrent(obj) end
    end, S.roomConns)
    bindCurrent(getCurrentRoom())
end

